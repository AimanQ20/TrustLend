{
  "name": "trustlend",
  "version": "1.0.0",
  "description": "TrustLend - peer-to-peer lending DApp. Member 1 package: access control, registry, role service, role UI.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:solcjs": "USE_SOLCJS=1 hardhat test",
    "coverage": "hardhat coverage",
    "gas": "hardhat run scripts/gas-report.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-registry.js --network localhost",
    "abi": "hardhat compile && node scripts/export-abi.js",
    "service": "node offchain/role-service/index.js",
    "frontend": "node frontend/serve.js",
    "demo:permissions": "hardhat run scripts/demo-permissions.js --network localhost"
  },
  "keywords": [
    "blockchain",
    "solidity",
    "hardhat",
    "access-control"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^18.0.10",
    "hardhat": "^2.29.2",
    "jsdom": "^24.1.3",
    "solc": "0.8.24"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "private": true
}